{
  "info": {
    "name": "dzastr-auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrlAuth", "value": "" },
    { "key": "serviceTokenAuth", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "serviceTokenMo", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"User_Username\": \"john\",\n  \"User_Role\": \"admin\",\n  \"User_Email\": \"john@example.com\",\n  \"User_Password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrlAuth}}/api/secure/register",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "secure", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.accessToken) { pm.environment.set('accessToken', json.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"User_Email\": \"john@example.com\",\n  \"User_Password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrlAuth}}/api/secure/login",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "secure", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.accessToken) { pm.environment.set('accessToken', json.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Verify token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrlAuth}}/api/secure/verify",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "secure", "verify"]
        }
      }
    },
    {
      "name": "Users - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"User_Username\": \"john\",\n  \"User_Role\": \"admin\",\n  \"User_Email\": \"john@example.com\",\n  \"User_Password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrlAuth}}/api/users",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "Users - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "url": {
          "raw": "{{baseUrlAuth}}/api/users",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "Users - Get by id",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "url": {
          "raw": "{{baseUrlAuth}}/api/users/1",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "users", "1"]
        }
      }
    },
    {
      "name": "Users - Update",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"User_Username\": \"john\",\n  \"User_Role\": \"admin\",\n  \"User_Email\": \"john@example.com\",\n  \"User_Password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrlAuth}}/api/users/1",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "users", "1"]
        }
      }
    },
    {
      "name": "Users - Delete",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "url": {
          "raw": "{{baseUrlAuth}}/api/users/1",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "users", "1"]
        }
      }
    }
  ]
}
