{
  "info": {
    "name": "dzastr-mo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrlMo", "value": "" },
    { "key": "serviceTokenAuth", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "serviceTokenMo", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login (get access token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-service-token", "value": "{{serviceTokenAuth}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"User_Email\": \"john@example.com\",\n  \"User_Password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{authBaseUrl}}/api/secure/login",
          "host": ["{{baseUrlAuth}}"],
          "path": ["api", "secure", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.accessToken) { pm.collectionVariables.set('accessToken', json.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Invoices - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-service-token", "value": "{{serviceTokenMo}}" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"client_id\": 1,\n  \"invoice_price\": 1200.5,\n  \"invoice_date\": \"2026-04-13\",\n  \"item_ids\": [1, 2]\n}"
        },
        "url": {
          "raw": "{{baseUrlMo}}/invoices/",
          "host": ["{{baseUrlMo}}"],
          "path": ["invoices", ""]
        }
      }
    },
